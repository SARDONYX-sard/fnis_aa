{
  "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build"],
  "cmake.ignoreCMakeListsMissing": true,
  "files.associations": {
    "**/*.lua": "xmake",
    "**/cxx/xmake.lua": "xmake",
    "**/tasks.lua": "xmake"
  },
  "files.exclude": {
    ".cache": true
    // ".xmake": true
  },
  "files.watcherExclude": {
    "**/.cache/**": true,
    "**/.git/objects/**": true,
    "**/.xmake/**": true,
    "**/build/**": true
  },
  "Lua.workspace.ignoreDir": [
    "xmake.lua",
    "/cxx/xmake.lua",
    "/tasks.lua",
    "/**/*.lua"
  ],
  "toml.formatter.alignEntries": true
}
